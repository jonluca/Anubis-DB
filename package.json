{
  "name": "anubis-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "yarn dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply anubis-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply anubis-db --remote",
    "db:info": "wrangler d1 info anubis-db",
    "migrate:postgres": "yarn tsx scripts/migrate-postgres-to-d1.ts --apply"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.92.0"
  },
  "packageManager": "yarn@4.14.1"
}
