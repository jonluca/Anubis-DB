{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".wrangler/**",
    ".pnpm-store/**",
    "coverage/**",
    "db/**",
    "dist/**",
    "dump/**",
    "node_modules/**",
    "src/logs/**"
  ],
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all"
}
